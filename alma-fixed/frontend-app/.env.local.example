# Copy this file to .env.local and fill in real values.
# Get these from Supabase Dashboard -> Project Settings -> API.

# Project URL — the bare project URL, NOT the /rest/v1/ REST endpoint.
# Correct:   https://axywttkqruayovuiagtj.supabase.co
# Incorrect: https://axywttkqruayovuiagtj.supabase.co/rest/v1/
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The PUBLIC publishable key (sb_publishable_...) — safe to expose to the
# browser, RLS protects the data. The classic anon JWT key is also accepted
# under VITE_SUPABASE_ANON_KEY if your project still uses it.
# Never put the "service_role" / sb_secret_ key here or in any VITE_ var.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
