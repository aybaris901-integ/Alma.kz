# Copy this file to .env.local and fill in real values.
# Get these from Supabase Dashboard -> Project Settings -> API.

# Project URL — the bare project URL, NOT the /rest/v1/ REST endpoint.
# Correct:   https://axywttkqruayovuiagtj.supabase.co
# Incorrect: https://axywttkqruayovuiagtj.supabase.co/rest/v1/
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The PUBLIC "anon" key (safe to expose to the browser — RLS protects the data).
# Never put the "service_role" / secret key here or in any VITE_-prefixed var.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
